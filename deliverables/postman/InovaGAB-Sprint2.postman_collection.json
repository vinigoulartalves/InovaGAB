{
  "info": {
    "name": "InovaGAB Sprint 2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Fluxo manual sem segredos no repositório. Importe o environment template e preencha senhas do .env local."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Líder",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('accessTokenLider', j.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"lider@inovagab.local\",\"senha\":\"{{senhaLider}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Operador1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('accessTokenOperador1', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"operador1@inovagab.local\",\"senha\":\"{{senhaOperador1}}\"}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Estratégias",
      "item": [
        {
          "name": "Criar estratégia (Líder)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('estrategiaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessTokenLider}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"titulo\":\"Postman Estratégia\",\"descricao\":\"Teste\",\"categoria\":\"Cat\",\"campanha\":\"Camp\",\"inicioVigencia\":\"2026-01-01\",\"fimVigencia\":\"2027-01-01\",\"ativa\":true}"
            },
            "url": "{{baseUrl}}/api/v1/estrategias"
          }
        }
      ]
    },
    {
      "name": "IA",
      "item": [
        {
          "name": "Analisar ideia (Gestor) — 503 sem chave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('503 ou 201 conforme AI_ENABLED', function () {",
                  "  pm.expect([201,503]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessTokenGestor}}" }],
            "url": "{{baseUrl}}/api/v1/ideias/{{ideiaId}}/analises-ia"
          }
        }
      ]
    }
  ]
}
