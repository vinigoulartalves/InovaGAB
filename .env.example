# Copie para .env com scripts/setup-dev.sh (não versionar .env).
# Ambiente de avaliação local — não use estes padrões em produção.

JWT_SECRET=
SEED_ENABLED=true

# IA opcional — core sobe sem chave; POST /ideias/{id}/analises-ia retorna 503
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
# Ver docs/sprint2/IA_GEMINI.md (modelo, endpoint, limites de quota Google AI Studio)

# Senhas dev para seed (etapa 3+) — geradas pelo setup-dev
DEV_PASSWORD_OPERADOR1=
DEV_PASSWORD_OPERADOR2=
DEV_PASSWORD_GESTOR=
DEV_PASSWORD_LIDER=

# Host (fora do Compose): use directConnection apenas para nó único exposto em localhost
# MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
